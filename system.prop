# Audio
use.voice.path.for.pcm.voip=false

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true

# Moto
ro.mot.build.customerid=retail

# Radio
persist.radio.aosp_usr_pref_sel=true
persist.radio.fi_supported=1
persist.vendor.cne.feature=1
persist.vendor.dpm.feature=0
DEVICE_PROVISIONED=1
ril.subscription.types=RUIM
telephony.lteOnCdmaDevice=1

# eBPF backport: declare a 5.10-equivalent kernel to A17's netbpfload so it stops
# version-gating on the real 4.9 string. Read via the ported kver_override support
# (Lineage gerrit 436692/469510) in KernelUtils.h + bpfloader.rs.
# MUST be >= 5.10.199: netbpfload enforces "Android V+ requires 5.10 kernel to be
# 5.10.199+" (2026-07-05 ramoops: 5.10.0 -> "Unsupported kernel version").
ro.bpf.kver_override=5.10.199
